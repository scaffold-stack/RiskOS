NODE_ENV=development
PORT=3001
HOST=0.0.0.0
WEB_ORIGIN=http://localhost:5173
# fixture = demo adapters; live = mainnet reads (positions + risk + advisory protect)
DATA_MODE=live
STACKS_API_URL=https://api.mainnet.hiro.so
BITFLOW_APP_API_URL=https://bff.bitflowapis.finance/api/app
BITFLOW_QUOTES_API_URL=https://bff.bitflowapis.finance/api/quotes
SBTC_EMILY_URL=https://sbtc-emily.com
BITCOIN_ESPLORA_URL=https://mempool.space/api
# Optional — uncomment when local Postgres is running
# docker compose up -d postgres && npm run db:migrate
# DATABASE_URL=postgresql://riskos:riskos@localhost:5432/riskos
NETWORK=mainnet
# Registry-event backfill is resumable; each run processes this many pages per contract.
BACKFILL_EVENT_PAGE_SIZE=50
BACKFILL_MAX_PAGES_PER_CONTRACT=10
BACKFILL_HTTP_CONCURRENCY=4
# Optional comma-separated registry principals for a deliberately scoped run.
# BACKFILL_CONTRACTS=
# Supplied by protocol reviewers; no synthetic golden outputs are bundled.
# GOLDEN_ADDRESSES_PATH=/secure/reviewed-mainnet-golden-addresses.json
# RISKOS_CANDIDATE_URL=https://api.example.com
CHAINHOOK_BEARER_TOKEN=replace-with-at-least-32-random-characters
OPERATIONS_BEARER_TOKEN=use-a-different-at-least-32-character-secret
# Required in production; strongly recommended for local mainnet reads.
# Anonymous Hiro quotas are not treated as a reliable production dependency.
# HIRO_API_KEY=
# Pyth's latest-price endpoint is authenticated. When configured, either source
# failing or exceeding this divergence threshold makes valuation unavailable.
PYTH_HERMES_URL=https://hermes.pyth.network
PYTH_HERMES_TOKEN=
PRICE_MAX_DIVERGENCE_BPS=150
# sha256 fingerprint(s) of trusted Ed25519 release public keys (comma-separated)
REGISTRY_TRUSTED_KEY_FINGERPRINTS=
# Prefer signed dual-reviewed release (see docs/signed-registry-milestone.md)
REGISTRY_SIGNED_PATH=registry/mainnet/2026-09-04.2.signed.json
# Local/live fallback only (never production): unsigned candidate
REGISTRY_CANDIDATE_PATH=registry/mainnet/2026-09-04.2.candidate.json
LOG_LEVEL=info
