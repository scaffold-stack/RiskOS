NODE_ENV=development
PORT=3001
HOST=0.0.0.0
WEB_ORIGIN=http://localhost:5173
# fixture = demo adapters; live = mainnet reads (positions + risk + advisory protect)
DATA_MODE=live
STACKS_API_URL=https://api.mainnet.hiro.so
# Required in production: a separately operated Stacks API/node. It must not
# resolve to the same deployment as STACKS_API_URL.
# QuickNode embeds its authentication token in the private endpoint URL, so the
# separate key is normally omitted. Other providers may require an x-api-key.
# STACKS_REFERENCE_API_URL=https://your-endpoint.stacks-mainnet.quiknode.pro/your-private-token
# STACKS_REFERENCE_API_KEY=
BITFLOW_APP_API_URL=https://bff.bitflowapis.finance/api/app
BITFLOW_QUOTES_API_URL=https://bff.bitflowapis.finance/api/quotes
# Official Hermetica application API used for sUSDh realized-APY and TVL evidence.
HERMETICA_API_URL=https://app.hermetica.fi
DEFILLAMA_YIELDS_API_URL=https://yields.llama.fi/pools
SBTC_EMILY_URL=https://sbtc-emily.com
BITCOIN_ESPLORA_URL=https://mempool.space/api
# Optional — uncomment when local Postgres is running
# docker compose up -d postgres && npm run db:migrate
# DATABASE_URL=postgresql://riskos:riskos@localhost:5432/riskos
NETWORK=mainnet
# Registry-event backfill is resumable; each run processes this many pages per contract.
BACKFILL_EVENT_PAGE_SIZE=50
BACKFILL_MAX_PAGES_PER_CONTRACT=10
BACKFILL_HTTP_CONCURRENCY=4
# Optional comma-separated registry principals for a deliberately scoped run.
# BACKFILL_CONTRACTS=
# Supplied by protocol reviewers; no synthetic golden outputs are bundled.
# GOLDEN_ADDRESSES_PATH=/secure/reviewed-mainnet-golden-addresses.json
# RISKOS_CANDIDATE_URL=https://api.example.com
CHAINHOOK_BEARER_TOKEN=replace-with-at-least-32-random-characters
OPERATIONS_BEARER_TOKEN=use-a-different-at-least-32-character-secret
# Canonical history recorder. Requires DATABASE_URL, current Chainhook ingestion,
# an active registry, and the same operations token configured on the API.
# RISKOS_API_URL=http://127.0.0.1:3001
# PORTFOLIO_OBSERVER_ADDRESSES=SP...,SP...
PORTFOLIO_OBSERVER_INTERVAL_SECONDS=300
# Required in production; strongly recommended for local mainnet reads.
# Anonymous Hiro quotas are not treated as a reliable production dependency.
# HIRO_API_KEY=
# RiskOS forms a 2-of-3 quorum from DIA, entitled Pyth feeds, and CoinGecko.
# A denied/unavailable/outlying source cannot veto two agreeing sources.
PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes
PYTH_HERMES_TOKEN=
# Free keyless reference. A free Demo key raises rate limits but is optional.
COINGECKO_API_URL=https://api.coingecko.com/api/v3
# COINGECKO_DEMO_API_KEY=
# Free public USD spot source; fixed BTC-USD and STX-USD product IDs only.
COINBASE_EXCHANGE_API_URL=https://api.exchange.coinbase.com
PRICE_MAX_DIVERGENCE_BPS=150
# Per-instance minute limit for anonymous expensive reads. Metered API keys use
# their monthly plan quota instead. Put Cloudflare/WAF limits in front as well.
PUBLIC_RATE_LIMIT_PER_MINUTE=60
# sha256 fingerprint(s) of trusted Ed25519 release public keys (comma-separated)
REGISTRY_TRUSTED_KEY_FINGERPRINTS=
# Prefer signed dual-reviewed release (see docs/signed-registry-milestone.md)
REGISTRY_SIGNED_PATH=registry/mainnet/2026-09-13.1.signed.json
# Local/live fallback only (never production): unsigned candidate
REGISTRY_CANDIDATE_PATH=registry/mainnet/2026-09-04.2.candidate.json
LOG_LEVEL=info
